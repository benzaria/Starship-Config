{
  "name": "any-config",
  "version": "1.0.3",
  "description": "Make ur `Config` in **multiple file** with `json`, `yaml`, `toml` and *More* **All at Once** and **Hot Reload** on **Change**",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "watch": "node index.js -w",
    "start:verbose": "node index.js -l",
    "watch:verbose": "node index.js -wl",
    "start:no-err": "node index.js --no-err",
    "watch:no-err": "node index.js --no-err"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "yaml": "^2.7.0"
  },
  "keywords": [
    "starship",
    "spaceship",
    "oh-mu-posh",
    "oh-mu-zsh",
    "config",
    "shell",
    "powershell",
    "zshell",
    "zsh",
    "bash",
    "yaml",
    "yml",
    "jsonc",
    "json",
    "toml"
  ],
  "maintainers": [
    {
      "name": "benzaria",
      "email": "benz.github@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benzaria/any-config"
  },
  "author": "benzaria",
  "license": "MIT"
}